{
  "name": "festival-website",
  "version": "0.1.0",
  "private": true,
  "description": "Public front door for WAiFF Seoul 2027. Static site; links to the existing Fillout form and Airtable interfaces.",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "npx --yes serve@14 out -l 3000",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "node --test tests/*.test.mjs",
    "verify": "npm run typecheck && npm run lint && npm run build && npm test"
  },
  "engines": {
    "node": ">=20.9"
  },
  "dependencies": {
    "@fillout/react": "3.1.2",
    "@fontsource-variable/bodoni-moda": "5.3.0",
    "@fontsource/ibm-plex-mono": "5.3.0",
    "@fontsource/ibm-plex-sans": "5.3.0",
    "@fontsource/noto-sans-kr": "5.3.0",
    "@fontsource/noto-serif-kr": "5.3.0",
    "next": "16.4.3",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.3",
    "postcss": "8.5.32",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.3"
  }
}
