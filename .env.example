# Copy to .env.local for local work, or enter these in the hosting
# dashboard (Cloudflare Pages → Settings → Environment variables).
# Every value here ends up in public page source. Never put a secret,
# API key or token in any of them.

# Full public address of this deployment, no trailing slash.
NEXT_PUBLIC_SITE_URL=https://www.aironi.com

# "staging" adds noindex everywhere and blocks crawlers in robots.txt.
# Only set "production" on the real public launch.
NEXT_PUBLIC_SITE_ENV=staging

# The ORIGINAL WAiFF Seoul 2027 intake form ("WAIFF-SEL-2027 Creator Intake").
# Make maps its answers by question ID, so a duplicate form breaks intake.
# The build refuses any other ID unless ALLOW_FILLOUT_FORM_CHANGE=true.
NEXT_PUBLIC_FILLOUT_FORM_ID=g1196pxKY4us

# Jury Room (Airtable interface), first page "Watch and score".
NEXT_PUBLIC_JURY_ROOM_URL=https://airtable.com/appdSfdAy414Bz0ZB/pagj3RxFr2z77MNgI

# Team Center (Airtable interface), first page "Overview".
NEXT_PUBLIC_TEAM_CENTER_URL=https://airtable.com/appdSfdAy414Bz0ZB/pagl8UXmGaSsmPMGD

# Staff sign-in link in the footer. Off until the festival decides it should be public.
NEXT_PUBLIC_SHOW_STAFF_LINK=true

# Lab: separate Zite booking app (writes to workshop_bookings; never the intake form). Empty = "Bookings open soon".
NEXT_PUBLIC_LAB_BOOKING_URL=
# Korean pages (/ko/). Leave both empty until the Korean form versions are set up and tested;
# until then Korean pages open the forms in English and say so.
# Entry form: the URL parameter(s) that make the SAME Fillout form open in Korean, e.g. language=ko
NEXT_PUBLIC_FILLOUT_KO_PARAMS=
# Lab booking: the Korean address of the same Zite app, e.g. https://r7n3my3uio.zite.so/?lang=ko
NEXT_PUBLIC_LAB_BOOKING_URL_KO=
# Show the Lab page and nav item.
NEXT_PUBLIC_SHOW_LAB=true
